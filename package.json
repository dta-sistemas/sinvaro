{
  "name": "sinvaro",
  "version": "0.1.0",
  "private": true,
  "description": "Sin Varo Cancún — guía de planes gratis, comida barata y ofertas en Cancún",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "content": "tsx scripts/content.ts",
    "audit": "tsx scripts/audit-site.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.64.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
