# URL pública del sitio (sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (newsletter y formulario de contacto). Sin estas variables los formularios
# responden "servicio no configurado" y NO guardan ni envían nada.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Sin Varo <hola@tudominio.com>"
RESEND_FROM=
# Correo que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=
# (Opcional) ID del segmento de Resend donde agregar a los suscriptores
RESEND_SEGMENT_NEWSLETTER=

# Solo desarrollo: muestra contenido de ejemplo marcado como [EJEMPLO] (ofertas, etc.)
SINVARO_SAMPLE_CONTENT=0
